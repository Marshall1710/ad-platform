{
  "name": "ad-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/cabinet",
    "apps/auction"
  ],
  "scripts": {
    "up": "docker compose up --build -d",
    "down": "docker compose down",
    "build": "docker compose build",
    "test": "npm run test:smoke",
    "test:smoke": "node scripts/check-db.mjs && playwright test",
    "test:go": "cd apps/dsp && go test ./...",
    "typecheck": "npm run typecheck --workspace=apps/cabinet && npm run typecheck --workspace=apps/auction"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  }
}
